# --- LINE ---
CHANNEL_ACCESS_TOKEN=
CHANNEL_SECRET=
SELF_NAME=@BOT
# LIFF app id backing the dice/diet input forms (public/liff/index.html),
# opened from the rich menu. Create it with `node scripts/liff.js create`.
LIFF_ID=

# --- Google service account ---
# Either point to a key file, or paste the whole JSON key as one line.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# --- Google Drive ---
# Fallback folder used when a conversation has no Folder config yet.
DRIVE_BASE_FOLDER_ID=

# --- Google Maps (Directions API) ---
GOOGLE_MAPS_API_KEY=

# --- Outgoing mail (used for the "forward LINE messages to email" feature) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Misc ---
PORT=3000
# Chat log and per-conversation config (Calendar/Folder/mail settings, set via
# the `cfg` LINE command) are stored in DATA_DIR/linebot.sqlite.
DATA_DIR=./data
# Group/user id that the daily "5 days ahead" schedule reminder is pushed to.
DAILY_SCHEDULE_TARGET=

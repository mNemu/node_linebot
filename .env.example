# --- LINE ---
CHANNEL_ACCESS_TOKEN=
CHANNEL_SECRET=
SELF_NAME=@BOT
# LIFF app id backing the dice/diet input forms (public/liff/index.html),
# opened from the rich menu. Create it with `node scripts/liff.js create`.
LIFF_ID=
# Public https origin this server is reachable at, no trailing slash
# (e.g. https://bot.example.com). Used to build absolute URLs LINE requires,
# such as the diet realism badge's tap-through explanation page.
PUBLIC_BASE_URL=

# --- Google service account ---
# Either point to a key file, or paste the whole JSON key as one line.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# --- Outgoing mail (used for the "forward LINE messages to email" feature) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Misc ---
PORT=3000
# Chat log and per-conversation config (Calendar/mail settings, set via
# `node scripts/cfg.js`) are stored in DATA_DIR/linebot.sqlite.
DATA_DIR=./data
# Group/user id that the daily "5 days ahead" schedule reminder is pushed to.
DAILY_SCHEDULE_TARGET=

# --- Score pages (LIFF: /liff/molkky/, /liff/golf/, /liff/scoreboard/) ---
# Their APIs require a LINE login (LIFF access token). For local development
# only, set this to 1 to also accept `Bearer dev:<userId>` without contacting
# LINE. Never enable in production.
LIFF_DEV_AUTH=
